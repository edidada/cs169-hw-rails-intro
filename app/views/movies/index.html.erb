<!--  This file is app/views/movies/index.html.erb -->

<h1>Movies</h1>

<%#  Part 2: The "Movie Title" and "Release Date" headers below are links that
     re-sort the table, with the active column highlighted. %>

<table id="movies" class="table table-striped table-hover">
  <caption class="visually-hidden">All movies.</caption>
  <thead>
    <tr>
      <th scope="col" id="title_header" class="<%= 'hilite bg-warning' if @sort == 'title' %>"><%= link_to 'Movie Title', movies_path(sort: 'title', ratings: @selected_ratings.index_by { |r| r }) %></th>
      <th scope="col">Rating</th>
      <th scope="col" id="release_date_header" class="<%= 'hilite bg-warning' if @sort == 'release_date' %>"><%= link_to 'Release Date', movies_path(sort: 'release_date', ratings: @selected_ratings.index_by { |r| r }) %></th>
      <th scope="col">More Info</th>
    </tr>
  </thead>
  <tbody>
    <% @movies.each do |movie| %>
      <%= render 'movie_row', movie: movie %>
    <% end %>
  </tbody>
</table>

<%# Part 1: Start here. This form submits back to /movies and uses the
    checkbox ids the hw asks for. %>
<%= form_tag movies_path, method: :get, id: 'ratings_form' do %>
  Include:
  <% @all_ratings.each do |rating| %>
    <%= rating %>
    <%= check_box_tag "ratings[#{rating}]", "1", @selected_ratings.include?(rating), id: "ratings_#{rating}" %>
  <% end %>
  <%= submit_tag 'Refresh', id: 'ratings_submit', class: 'btn btn-primary' %>
<% end %>

<%= link_to "New movie", new_movie_path, class: 'btn btn-primary' %>
